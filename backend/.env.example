# MongoDB Atlas 연결 문자열
# MongoDB Atlas → Connect → Drivers → 복사한 URI 붙여넣기
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ghosttracker?retryWrites=true&w=majority

# 서버 포트 (로컬 개발용, Render는 자동 설정)
PORT=4000

# 허용할 쇼핑몰 도메인 (콤마로 구분)
# 예: https://jh-web-nu.vercel.app,https://other-shop.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://jh-web-nu.vercel.app

# ── 사이트별 접근 키 (멀티테넌시) ─────────────────────────────────
# 형식: 키:origin,키:origin
# 대시보드를 https://서버/operator-dashboard.html?key=키 로 열면
# 그 키에 연결된 쇼핑몰 데이터만 보인다.
#
# 설정하지 않으면 "개방 모드"로 동작한다.
#   → 누구나 모든 쇼핑몰의 세션·리포트를 조회할 수 있다.
#   → 로컬 개발에서만 허용. 배포 환경에서는 반드시 설정할 것.
#
# 키는 추측하기 어려운 값으로 만든다:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SITE_KEYS=

# Python 추론 서버 URL
# 배포 환경에서 비워두면 localhost:5002로 붙으려다 실패한다 (ML 기능 전체 중단)
CLUSTER_SERVER_URL=http://localhost:5002
PREDICT_SERVER_URL=http://localhost:5001

# Gemini API 키 (리포트 자연어 생성용, 없으면 로컬 fallback 문장 사용)
GEMINI_API_KEY=
